@article{moghaddasOPUFObfuscatedPUF2025,
  abbr = {JCSC},
  title = {{OPUF}: {Obfuscated} {PUF} against {Machine} {Learning} {Modeling} {Attacks}},
  author = {Moghaddas, Mostafa and Pandi, Marziye and Beitollahi, Hakem},
  journal = {Journal of Circuits, Systems and Computers},
  volume = {34},
  number = {11},
  pages = {2550245},
  year = {2025},
  doi = {10.1142/S0218126625502457},
  selected = {true},
  bibtex_show = {true},
  code = {https://github.com/m-mghds/opuf},
  abstract = {Physical Unclonable Functions (PUFs) are vulnerable to machine learning modeling attacks that can predict their responses. To counter this threat, we introduce Obfuscated PUF (OPUF), a novel PUF design that employs advanced obfuscation techniques to enhance security. OPUF significantly outperforms existing PUFs in terms of resistance to machine learning attacks, including logistic regression (LR) and multilayer perceptron (MLP). It achieves a 50.69\% and 49.54\% accuracy reduction in LR and MLP attacks, respectively, compared to the best-performing existing PUFs. Moreover, OPUF maintains excellent quality metrics, with 50\% uniqueness and 50.15\% uniformity, demonstrating its inherent randomness and unpredictability.}
}

@article{pandiTestLockTestabilityLogic2025,
  abbr = {J Supercomput},
  title = {{TestLock}: a testability logic locking method against machine learning-based oracle-less attacks},
  author = {Pandi, Marziye and Moghaddas, Mostafa and Beitollahi, Hakem},
  journal = {The Journal of Supercomputing},
  volume = {81},
  number = {14},
  pages = {1320},
  year = {2025},
  doi = {10.1007/s11227-025-07803-9},
  selected = {true},
  bibtex_show = {true},
  abstract = {Logic Locking (LL) is a crucial technique for safeguarding intellectual property (IP) within the semiconductor supply chain. TestLock is a logic-locking method that leverages circuit testability metrics to enhance resistance against machine-learning-based oracle-less attacks. The method strategically selects node pairs based on controllability and observability and is evaluated against attacks including MuxLink and SCOPE.}
}

@article{beitollahiEdgesorterHardwareSorting2024,
  abbr = {MICPRO},
  title = {Edge-Sorter: {A} hardware sorting engine for area \& power constrained edge computing devices},
  author = {Beitollahi, Hakem and Pandi, Marziye and Moghaddas, Mostafa},
  journal = {Microprocessors and Microsystems},
  volume = {105},
  pages = {105006},
  year = {2024},
  doi = {10.1016/j.micpro.2024.105006},
  selected = {false},
  bibtex_show = {true},
  abstract = {Edge-Sorter is a hardware sorting engine designed for edge devices with limited hardware resources. The architecture targets low area and power consumption and supports scalable sorting of records with arbitrary data widths. It was evaluated using both Xilinx Vivado FPGA synthesis and a Synopsys Design Compiler ASIC flow.}
}